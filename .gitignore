# Raw standardized SBBTS paths written next to the panel by scripts/sbbts_generate.py
data/curated/*.paths.pt

# Benchmark result CSVs: only the canonical files and default-parameter
# (B=100, tickers/draw=200, seed=42) runs are tracked. Other parameter
# combinations are cheap to regenerate and would otherwise clutter
# history with one-off/smoke-test runs; runs_manifest.csv still records
# that every run happened, regardless of whether its CSV is tracked.
scripts/results/benchmark_B*_m*_seed*_*.csv
scripts/results/aggregate_B*_m*_seed*_*.csv
!scripts/results/benchmark_B100_m200_seed42_*.csv
!scripts/results/aggregate_B100_m200_seed42_*.csv

# Same policy at the current results/ path (the rules above predate the
# 2026-07 move out of scripts/). Default-parameter spec-primary runs stay
# trackable; other parameter combinations and whole sweep directories are
# ignored. runs_manifest.csv is never ignored: it records every run.
results/benchmark_spec-*_B*_m*_seed*_*.csv
results/aggregate_spec-*_B*_m*_seed*_*.csv
!results/benchmark_spec-primary_B100_m200_seed42_*.csv
!results/aggregate_spec-primary_B100_m200_seed42_*.csv
!results/outer_*_replicates_spec-primary_B100_m200_seed42_*.csv
results/sweep_*/
